# —— 虹越智造平台 环境配置示例（复制为 .env 后修改）——
APP_NAME="虹越智造平台"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:8000
# 测试时钟（留空使用真实时间；例如 2026-09-11 09:00:00）
APP_TEST_NOW=

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

# 日志：daily 按天滚动；生产建议 daily
LOG_CHANNEL=stack
LOG_LEVEL=debug

# 数据库（MySQL 8）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hongyue
DB_USERNAME=hongyue
DB_PASSWORD=hongyue123

# 缓存 / 队列 / 会话（生产建议 redis）
# 注意：本地开发若无 Redis 服务，请将 CACHE_STORE 改为 array、QUEUE_CONNECTION 改为 sync、
# SESSION_DRIVER 改为 file，否则 RBAC 权限缓存等依赖 Redis 的功能会报错。
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Sanctum 前端域名（带端口；PC 端 Vite 开发地址）
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# 企业微信（一期骨架：可后接入，未配置时走账号密码回退）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/wecom-callback

# 微信小程序（一期骨架）
WX_APP_ID=
WX_APP_SECRET=

# 内部 AI 服务（二期启用）
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TOKEN=

# 金蝶云星空（三/四期启用，一期留空）
K3_BASE_URL=
K3_ACCT_ID=
K3_USERNAME=
K3_PASSWORD=

# 邮件（预留）
MAIL_MAILER=log

# OSS（预留）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# 此文件只作说明。manage.py init 会生成独立 .env，并自动生成所有密钥。
# 值使用单引号；不要写 shell 命令或变量引用。不要把生成的 .env 提交 Git。
COMPOSE_PROJECT_NAME='hongyue-prod'
IMAGE_PREFIX='hongyue'
RELEASE_TAG='请替换为本次 Git 提交号'
PC_DOMAIN='mes.example.com'
MOBILE_DOMAIN='h5.example.com'
BIND_ADDRESS='0.0.0.0'
HTTP_PORT='80'
HTTPS_PORT='443'
TLS_DIR='./deploy/production/tls'
BACKUP_DIR='./deploy/production/backups'
APP_KEY='由初始化脚本生成'
DB_DATABASE='hongyue'
DB_USERNAME='hongyue'
DB_PASSWORD='由初始化脚本生成'
MYSQL_ROOT_PASSWORD='由初始化脚本生成'
REDIS_PASSWORD='由初始化脚本生成'
AI_SERVICE_TOKEN='由初始化脚本生成'
MP_APP_KEY='由初始化脚本生成'
MP_APP_SECRET='由初始化脚本生成'
LOG_LEVEL='info'
# 首次安装不启动后台任务。确认集成配置后再按部署说明启用。
ENABLE_QUEUE='0'
ENABLE_SCHEDULER='0'
EXTERNAL_INTEGRATIONS_CONFIRMED='0'
# 未配置金蝶时指向容器自身的关闭端口，且不使用模拟成功回执。
K3_BASE_URL='http://127.0.0.1:9'
K3_MOCK='false'
K3_ACCT_ID=''
K3_USERNAME=''
K3_PASSWORD=''
K3_STOCK_ID=''
K3_BILL_TYPE_ID=''
K3_CREATOR_ID=''
MP_PUSH_URL=''
WECOM_CORP_ID=''
WECOM_AGENT_ID=''
WECOM_SECRET=''
WX_APP_ID=''
WX_APP_SECRET=''
DEEPSEEK_API_KEY=''
DEEPSEEK_MODEL='deepseek-chat'

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY deploy/production/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && useradd --uid 10001 --create-home app
COPY ai-service/app ./app
COPY deploy/production/ai-health.py /opt/production/ai-health.py
COPY deploy/production/ai-start.py /opt/production/ai-start.py
USER app
CMD ["python", "/opt/production/ai-start.py"]
